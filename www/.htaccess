# GYM-ZERO · Seguretat del servidor web (Apache)

# No ensenyar la llista de fitxers d'una carpeta que no té index.php
Options -Indexes

# A gymzero.cat, sempre per https (a l'XAMPP no es toca res)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^(www\.)?gymzero\.cat$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://gymzero.cat%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # El navegador recorda durant un any que aquesta web només va per https
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  # Cap altra web no pot posar-nos dins un marc per enganyar els clics (clickjacking)
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  # El navegador no endevina el tipus dels fitxers
  Header always set X-Content-Type-Options "nosniff"
  # Les altres webs no veuen les adreces internes (per exemple, enllaços amb codis)
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Fitxers que no s'han de poder descarregar mai
<FilesMatch "\.(sql|gz|log|md|sh|bak|ini)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
